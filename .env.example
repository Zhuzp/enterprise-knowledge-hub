# ========== 数据库 ==========
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=user
PG_PASSWORD=pass
PG_DATABASE=knowledge

# ========== JWT ==========
SECRET_KEY=change-me-in-production

# ========== MinIO ==========
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# ========== DashScope / 通义（LLM + Embedding + 视频理解）==========
# 在 https://dashscope.console.aliyun.com/ 创建 API Key（sk- 开头）

# 国内账号（默认）
OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus

# 国际账号请改用：
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v4

# 视频解析 — 多模态 VL（403 时检查控制台是否已开通 qwen-vl-plus）
VIDEO_MODEL=qwen-vl-plus

# 开发阶段不想调 VL API、先跑通上传解析流程：
# VIDEO_UNDERSTAND_MOCK=true

# API 失败时仍完成解析（写入占位说明），默认 true
# VIDEO_UNDERSTAND_FAIL_OPEN=true

# ========== Rerank（独立 endpoint，勿与 OPENAI_BASE_URL 混用）==========
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
RERANK_MODEL=qwen3-rerank

# ========== Redis / ES / Neo4j / RabbitMQ ==========
REDIS_URL=redis://127.0.0.1:6379/0
ES_HOST=http://127.0.0.1:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ========== Mem0（可选）==========
MEM0_ENABLED=false

# ========== Langfuse（线上观测，默认关闭）==========
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Cloud 欧盟默认；自建改为 http://localhost:3000
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
